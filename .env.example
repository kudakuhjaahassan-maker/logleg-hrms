# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logleg_hrms?schema=public"

# Application
PORT=3000
NODE_ENV=development

# Authentication (use a long, random secret in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=12

# Transactional email for password resets (Resend: https://resend.com/api-keys)
RESEND_API_KEY=
MAIL_FROM="LOGLEG HRMS <no-reply@yourdomain.com>"
# Public URL of the app, used to build password reset links (optional; falls back to the request origin)
APP_URL=
