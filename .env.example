# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logleg_hrms?schema=public"

# Application
PORT=3000
NODE_ENV=development

# Authentication (use a long, random secret in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=12

# Transactional email for password resets.
#
# Preferred: the Resend HTTPS API. It sends over port 443, so hosts that block
# outbound SMTP (Railway times out on 465/587) still deliver mail.
# Create a key at https://resend.com/api-keys, and verify a sending domain in
# Resend — without a verified domain Resend only delivers to your own address
# (use "onboarding@resend.dev" as MAIL_FROM for a quick test).
RESEND_API_KEY=
MAIL_FROM="LOGLEG HRMS <no-reply@yourdomain.com>"

# Optional fallback: Gmail SMTP. SMTP_PASS must be a Google App Password, not the
# account password: https://myaccount.google.com/apppasswords
# Used only when RESEND_API_KEY is empty.
SMTP_USER=
SMTP_PASS=
# Public URL of the app, used to build password reset links (optional; falls back to the request origin)
APP_URL=
