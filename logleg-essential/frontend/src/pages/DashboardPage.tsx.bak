import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import { useAuth } from "../api/AuthContext";
import { api, type LeaveRequest } from "../api/client";
import ClockWidget from "../components/ClockWidget";
import LeaderboardCard from "../components/LeaderboardCard";

export default function DashboardPage() {
  const { user } = useAuth();
  const [recentLeaves, setRecentLeaves] = useState<LeaveRequest[]>([]);
  const canManage = user?.role === "MANAGER" || user?.role === "HR_ADMIN" || user?.role === "SUPER_ADMIN";

  useEffect(() => {
    (async () => {
      try {
        const res = await api.listLeaves({ mine: true });
        setRecentLeaves(res.leaveRequests.slice(0, 5));
      } catch {
        // ignore dashboard secondary data errors
      }
    })();
  }, []);

  return (
    <div className="page">
      <div className="page-header">
        <div>
          <h1>Dashboard</h1>
          <p className="muted">Welcome back{user ? `, ${user.firstName}` : ""}. Track your attendance and leave at a glance.</p>
        </div>
      </div>

      <div className="grid-dashboard">
        <ClockWidget />

        <div className="card">
          <div className="card-header-row">
            <h3>My Recent Leave Requests</h3>
            <Link to="/leave" className="link">View all</Link>
          </div>
          {recentLeaves.length === 0 ? (
            <p className="muted">No leave requests yet.</p>
          ) : (
            <ul className="simple-list">
              {recentLeaves.map((r) => (
                <li key={r.id} className="simple-list-item">
                  <div>
                    <div className="strong">{r.leaveType}</div>
                    <div className="subtle">{String(r.startDate).slice(0,10)} → {String(r.endDate).slice(0,10)}</div>
                  </div>
                  <span className={`badge status-${r.status}`}>{r.status}</span>
                </li>
              ))}
            </ul>
          )}
          <div style={{ marginTop: 12 }}>
            <Link to="/leave" className="btn btn-secondary btn-sm">Request leave</Link>
          </div>
        </div>
      </div>

      <LeaderboardCard compact />

      <div className="card">
        <h3>Quick links</h3>
        <div className="quick-links">
          <Link className="quick-link" to="/directory">
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.72l-7-4a2 2 0 0 0-1.73-1H3.73l7 4a2 2 0 0 0 1.73-1zm0 0l7 4a2 2 0 0 1 1.73 1H21" /></svg>
            </span>
            <strong>Employee Directory</strong>
            <span>Search employees, departments, and status</span>
          </Link>
          <Link className="quick-link" to="/org-chart">
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6" /></svg>
            </span>
            <strong>Org Chart</strong>
            <span>View reporting lines</span>
          </Link>
          <Link className="quick-link" to="/leave">
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M13 6V4s-2 1-3 2s-2 1-3 2s-2 1-3 2" /></svg>
            </span>
            <strong>Leave</strong>
            <span>Submit requests and track status</span>
          </Link>
          <Link className="quick-link" to="/compensation">
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M6 6L6 2h4l2 4h2l2-4h4l-4 4h2z" /></svg>
            </span>
            <strong>My Compensation</strong>
            <span>Salary, overtime earnings and payslips</span>
          </Link>
          {canManage && <Link className="quick-link" to="/leave-approvals">
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 6v14a2 2 0 0 1 2 2h2" /></svg>
            </span>
            <strong>Leave Approvals</strong>
            <span>Review pending team requests</span>
          </Link>}
          {canManage && <Link className="quick-link" to="/attendance">
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 2v4l10 8 10-8v-4l-10-8L12 2z" /></svg>
            </span>
            <strong>Daily Attendance</strong>
            <span>See who is clocked in, late, or absent</span>
          </Link>}
          {canManage && <Link className="quick-link" to="/payslips">
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 h-2a2 2 0 0 1-2-2V2z" /></svg>
            </span>
            <strong>Payslips Review</strong>
            <span>Generated payslips ready for payout</span>
          </Link>}
          {user && <Link className="quick-link" to={`/employees/${user.id}`}>
            <span className="quick-link-icon" style={{ background: "var(--primary-color)", color: "var(--text-on-primary)" }}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M19 21l-2-2l-7-7l-2 2l7 7z" /></svg>
            </span>
            <strong>My Profile</strong>
            <span>Your information and history</span>
          </Link>
        </div>
      </div>
    </div>
  );
}
