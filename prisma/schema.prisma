// LOGLEG HRMS - Prisma schema (PostgreSQL)
// Multi-tenant design: every business record is scoped by company_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}
}

/// Pending subscription request for Viber payment verification
model PendingSubscriptionRequest {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @db.Uuid
  userId        String             @db.Uuid
  email         String
  tier          SubscriptionPlan   /// starter / growth / enterprise
  status        String             @default("pending")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@index([tier])
  @@map("pending_subscription_requests")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

/// Tenant: a company/organization using LOGLEG.
model Company {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  slug               String             @unique
  domain             String?            @unique
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  /// Corporate branding: optional logo image URL and primary accent colour (hex).
  logoUrl            String?
  primaryColor       String             @default("#2563eb")
  /// Workspace card/container surface tone (hex).
  cardBgColor        String             @default("#ffffff") @map("card_bg_color")
  /// Header/sidebar palette: "light", "dark", or "brand".
  sidebarTheme       String             @default("light") @map("sidebar_theme")
  /// Custom text colours for headings and descriptions.
  headingTextColor   String             @default("#0f172a") @map("heading_text_color")
  subTextColor       String             @default("#64748b") @map("sub_text_color")
  /// Payroll configuration fields.
  defaultCurrency    String             @default("USD") @map("default_currency")
  standardWorkHours  Decimal            @default(8) @db.Decimal(5, 2) @map("standard_work_hours")
  overtimeMultiplier Decimal            @default(1.5) @db.Decimal(5, 2) @map("overtime_multiplier")
  /// Company office location used for geofence check-ins. Null disables the geofence check.
  officeLatitude     Float?             @map("office_latitude")
  officeLongitude    Float?             @map("office_longitude")
  /// Default check-in radius (meters); a user's customRadiusMeters overrides it.
  allowedRadiusMeters Int               @default(20) @map("allowed_radius_meters")
  /// IANA timezone shift times and attendance days are interpreted in, e.g. "Indian/Maldives".
  timezone           String             @default("Indian/Maldives") @map("timezone")
  settings           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  departments    Department[]
  employees      User[]
  leaveRequests  LeaveRequest[]
  attendanceLogs AttendanceLog[]
  payrollRecords PayrollRecord[]

  @@index([name])
  @@map("companies")
}

/// Department within a company.
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

/// Employee/user account. Scoped to a tenant via company_id.
model User {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String
  title        String?
  role         UserRole       @default(EMPLOYEE)
  departmentId String?        @db.Uuid
  managerId    String?        @db.Uuid
  phone        String?
  hireDate     DateTime?      @db.Date
  status       EmployeeStatus @default(ACTIVE)
  /// HR-managed employee documents/links metadata (e.g. [{name,url,type,uploadedAt}]).
  documents    Json           @default("[]")

  /// Compensation (per-employee, set by HR/admin)
  baseSalary         Decimal @default(0) @db.Decimal(12, 2)
  currencySymbol     String  @default("$") @db.VarChar(10)
  standardHoursPerDay Decimal @default(8) @db.Decimal(5, 2)
  overtimeHourlyRate Decimal @default(0) @db.Decimal(12, 2)
  /// Day of month (1-31) when the previous month's payslip is generated for review.
  payslipGenerationDay Int   @default(28)

  /// Allowances & bonuses (togglable, amounts included in gross when active)
  foodAllowanceEnabled          Boolean @default(false)
  foodAllowanceAmount           Decimal @default(0) @db.Decimal(12, 2)
  accommodationAllowanceEnabled Boolean @default(false)
  accommodationAllowanceAmount  Decimal @default(0) @db.Decimal(12, 2)
  punctualityAllowanceEnabled   Boolean @default(false)
  punctualityAllowanceAmount    Decimal @default(0) @db.Decimal(12, 2)
  uniformAllowanceEnabled       Boolean @default(false)
  uniformAllowanceAmount        Decimal @default(0) @db.Decimal(12, 2)
  transportPhoneAllowanceEnabled Boolean @default(false)
  transportPhoneAllowanceAmount  Decimal @default(0) @db.Decimal(12, 2)
  ramadanAllowanceEnabled       Boolean @default(false)
  ramadanAllowanceAmount        Decimal @default(0) @db.Decimal(12, 2)

  /// Yearly performance bonus (criteria/target defined by admin; included in gross when active)
  yearlyBonusEnabled  Boolean @default(false)
  yearlyBonusAmount   Decimal @default(0) @db.Decimal(12, 2)
  yearlyBonusCriteria String? @db.Text

  /// Per-employee check-in radius in meters; overrides the company's allowedRadiusMeters when set.
  customRadiusMeters Int?      @map("custom_radius_meters")
  /// Employee shift window ("HH:MM", UTC) used for late and overtime calculation.
  shiftStartTime     String    @default("09:00") @map("shift_start_time")
  shiftEndTime       String    @default("17:00") @map("shift_end_time")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    User?       @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    User[]      @relation("EmployeeManager")

  leaveRequests  LeaveRequest[]
  attendanceLogs AttendanceLog[]
  payrollRecords PayrollRecord[]
  passwordResetTokens PasswordResetToken[]

  /// Email must be unique within a tenant. (Allows same email in different companies if needed.)
  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, role])
  @@index([departmentId])
  @@index([managerId])
  @@map("users")
}

/// Marks one-time data fixes that already ran, so boot-time fixes apply exactly once.
model AppDataMigration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("app_data_migrations")
}

/// Single-use token for self-service password resets.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  companyId String    @db.Uuid
  /// SHA-256 hash of the emailed token; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("password_reset_tokens")
}

/// Leave/time-off request submitted by an employee.
model LeaveRequest {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @db.Uuid
  employeeId String             @db.Uuid
  leaveType  LeaveType
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  status     LeaveRequestStatus @default(PENDING)
  reason     String?            @db.Text
  reviewedBy String?            @db.Uuid
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([companyId, status])
  @@index([companyId, startDate, endDate])
  @@map("leave_requests")
}

/// Daily attendance record for an employee.
model AttendanceLog {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  employeeId String    @db.Uuid
  clockIn    DateTime?
  clockOut   DateTime?
  date       DateTime  @db.Date
  notes      String?   @db.Text
  /// Distance (meters) from the office recorded at clock-in; null when no geofence was applied.
  checkInDistanceMeters Float? @map("check_in_distance_meters")
  /// Minutes late against the employee's shift start (0 once the shift target is met).
  lateMinutes     Int @default(0) @map("late_minutes")
  /// Minutes worked beyond the shift target, after late make-up.
  overtimeMinutes Int @default(0) @map("overtime_minutes")
  /// When late/overtime minutes were computed from the shift. Null on rows logged before
  /// shift metrics existed, so payroll derives their overtime instead of paying the 0 default.
  metricsComputedAt DateTime? @map("metrics_computed_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One attendance record per employee per day within a company.
  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@index([employeeId, date])
  @@map("attendance_logs")
}

/// Payroll record / payslip for an employee for a given pay period.
model PayrollRecord {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  employeeId     String        @db.Uuid
  baseSalary     Decimal       @db.Decimal(12, 2)
  regularPay     Decimal       @default(0) @db.Decimal(12, 2)
  overtimeHours  Decimal       @default(0) @db.Decimal(8, 2)
  overtimePay    Decimal       @default(0) @db.Decimal(12, 2)
  allowancesTotal Decimal      @default(0) @db.Decimal(12, 2)
  yearlyBonus    Decimal       @default(0) @db.Decimal(12, 2)
  /// Active allowances/bonus line items included in this payslip (snapshot).
  allowancesBreakdown Json     @default("[]")
  grossPay       Decimal       @default(0) @db.Decimal(12, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  netPay         Decimal       @db.Decimal(12, 2)
  currency       String        @default("$") @db.VarChar(10)
  payPeriodMonth Int
  payPeriodYear  Int
  status         PayrollStatus @default(DRAFT)
  generatedAt    DateTime?
  processedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Prevent duplicate payroll entries for the same employee and period.
  @@unique([companyId, employeeId, payPeriodYear, payPeriodMonth])
  @@index([companyId, payPeriodYear, payPeriodMonth])
  @@index([employeeId])
  @@map("payroll_records")
}
